# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Cloud setup only (scripts/cloud-setup.mjs) — use one of:
# SUPABASE_DB_PASSWORD=your-database-password
# SUPABASE_ACCESS_TOKEN=your-personal-access-token

# Facebook / Meta (for Social Media sync)
FACEBOOK_PAGE_ID=your_page_id
FACEBOOK_USER_ACCESS_TOKEN=your_user_access_token
FACEBOOK_PAGE_ACCESS_TOKEN=your_page_access_token
# Optional: for long-lived token exchange (Meta Developer Console → App → Settings → Basic)
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# Termii SMS (Nigeria) — required for Communications send
TERMII_API_KEY=
TERMII_SENDER_ID=CCC

# OpenAI (AI assistant / comment analysis) — optional; keyword fallback used when empty
OPENAI_API_KEY=

# Google Maps (optional; maps module uses Leaflet by default)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# App (use your Vercel URL in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
