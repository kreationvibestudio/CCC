# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Cloud setup only (scripts/cloud-setup.mjs) — use one of:
# SUPABASE_DB_PASSWORD=your-database-password
# SUPABASE_ACCESS_TOKEN=your-personal-access-token

# Facebook / Meta (for Social Media sync)
# Prefer a never-expiring PAGE token (see supabase/FACEBOOK-SETUP.md)
FACEBOOK_PAGE_ID=671649942702174
FACEBOOK_USER_ACCESS_TOKEN=
FACEBOOK_PAGE_ACCESS_TOKEN=
# Required for automatic long-lived user-token refresh
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# When Meta tokens are missing, Social Media can load sample posts for local demos.
# Never set this to true in Production if live tokens exist — live sync always wins when tokens are set.
# SOCIAL_DEMO_MODE=true
SOCIAL_DEMO_MODE=
# Required: authorize /api/cron/facebook-sync (Vercel sends Bearer CRON_SECRET)
CRON_SECRET=
# Field Agent: code-only login when GPS is off. Leave unset in production —
# check-in must be within 100 ft of the polling-unit pin.
# AGENT_LOGIN_SOFT_GPS=true

# Termii SMS (Nigeria) — required for Communications send
TERMII_API_KEY=
TERMII_SENDER_ID=HoR2027
# Termii WhatsApp (optional) — volunteer training codes
# Device ID from Termii manage-device. Template must be WhatsApp-approved.
TERMII_WHATSAPP_DEVICE_ID=
TERMII_WHATSAPP_TEMPLATE_ID=
# Optional. Default name,code,url. Use 1,2,3 if the approved template uses numbered variables.
TERMII_WHATSAPP_DATA_KEYS=name,code,url
# Termii email (optional) — volunteer training codes
# Email configuration + template from the Termii dashboard Email product.
TERMII_EMAIL_CONFIGURATION_ID=
TERMII_EMAIL_TEMPLATE_ID=
TERMII_EMAIL_SUBJECT=Your volunteer training code
TERMII_EMAIL_VARIABLE_KEYS=name,code,url

# OpenAI (AI assistant / comment analysis) — optional; keyword fallback used when empty
OPENAI_API_KEY=

# Google Geocoding (optional; used by Fill missing map pins / `npm run pu:geocode`)
# A server key is better: GOOGLE_GEOCODING_API_KEY. Browser Maps keys also work if Geocoding API is enabled.
GOOGLE_GEOCODING_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Mapbox public token for campaign maps (also used as a geocoding fallback)
NEXT_PUBLIC_MAPBOX_TOKEN=

# App (use your Vercel URL in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated emails that can open /platform (vendor console)
PLATFORM_OPERATOR_EMAILS=

# Paystack donate page (hosted checkout)
NEXT_PUBLIC_PAYSTACK_PAYMENT_LINK=https://paystack.shop/pay/816txayv39
# Optional: auto-record Paystack charges into Campaign CRM
PAYSTACK_SECRET_KEY=

# Keep Server Action IDs stable across `next dev` restarts (avoids
# "Server Action was not found on the server"). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
