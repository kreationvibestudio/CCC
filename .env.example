# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Cloud setup only (scripts/cloud-setup.mjs) — use one of:
# SUPABASE_DB_PASSWORD=your-database-password
# SUPABASE_ACCESS_TOKEN=your-personal-access-token

# Facebook / Meta (for Social Media sync)
# Prefer a never-expiring PAGE token (see supabase/FACEBOOK-SETUP.md)
FACEBOOK_PAGE_ID=671649942702174
FACEBOOK_USER_ACCESS_TOKEN=
FACEBOOK_PAGE_ACCESS_TOKEN=
# Required for automatic long-lived user-token refresh
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Optional: authorize /api/cron/facebook-sync outside Vercel Cron
# CRON_SECRET=

# Termii SMS (Nigeria) — required for Communications send
TERMII_API_KEY=
TERMII_SENDER_ID=CCC

# OpenAI (AI assistant / comment analysis) — optional; keyword fallback used when empty
OPENAI_API_KEY=

# Google Maps (optional; maps module uses Leaflet by default)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# App (use your Vercel URL in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
